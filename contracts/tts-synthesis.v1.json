{
  "version": "tts-synthesis.v1",
  "provider": "ava-82m-persian-cpu",
  "apiProviderKey": "local-http",
  "independentOf": [
    "llm",
    "whisper",
    "livekit",
    "ffmpeg"
  ],
  "request": {
    "method": "POST",
    "path": "/synthesize",
    "contentType": "application/json",
    "requiredHeaders": [
      "x-tts-contract-version",
      "x-request-id",
      "x-tts-secret"
    ],
    "body": {
      "required": [
        "spokenText"
      ],
      "additionalProperties": false,
      "maxTextChars": 4000
    }
  },
  "response": {
    "contentType": "audio/wav",
    "maxAudioBytes": 20971520,
    "requiredHeaders": [
      "x-tts-contract-version",
      "x-request-id",
      "x-tts-provider"
    ],
    "validateWav": true,
    "acceptedContentTypes": [
      "audio/mpeg",
      "audio/wav"
    ],
    "validateMp3": true
  },
  "health": {
    "method": "GET",
    "path": "/health",
    "versioned": true,
    "doesNotProbeOtherComponents": true
  },
  "commandAdapter": {
    "shell": false,
    "stdin": "disabled",
    "textTransport": "utf8-temporary-file",
    "requiredPlaceholders": [
      "{text_file}",
      "{output_wav}"
    ],
    "workspaceOnlyPaths": true
  },
  "process": {
    "timeoutSeconds": {
      "default": 60,
      "min": 0.05,
      "max": 300
    },
    "terminationGraceSeconds": {
      "default": 2,
      "min": 0.05,
      "max": 10
    },
    "processGroupIsolation": true,
    "terminateThenKill": true,
    "diagnosticMaxBytes": 8192
  },
  "cleanup": {
    "temporaryWorkspace": true,
    "removeOnSuccess": true,
    "removeOnFailure": true,
    "spokenTextPersistedByWorker": false,
    "audioPersistedByWorker": false
  },
  "client": {
    "requestTimeoutMs": 65000,
    "maxAttempts": 2,
    "retryBaseMs": 200,
    "retryableHttpStatuses": [
      429,
      500,
      502,
      503,
      504
    ],
    "redirects": "manual",
    "productionHttpsRequired": true
  },
  "coreSafety": {
    "clientSuppliedTextAccepted": false,
    "source": "persisted finalized interview_turns.spoken_text",
    "realCustomerCandidateDevelopmentBridgeBlocked": true,
    "globalRealtimeReadinessRequiredForSynthesis": false
  },
  "errors": [
    {
      "code": "invalid_request",
      "retryable": false
    },
    {
      "code": "unauthorized",
      "retryable": false
    },
    {
      "code": "contract_mismatch",
      "retryable": false
    },
    {
      "code": "payload_too_large",
      "retryable": false
    },
    {
      "code": "provider_unavailable",
      "retryable": true
    },
    {
      "code": "provider_timeout",
      "retryable": true
    },
    {
      "code": "provider_error",
      "retryable": true
    },
    {
      "code": "invalid_audio_output",
      "retryable": true
    },
    {
      "code": "worker_error",
      "retryable": true
    }
  ],
  "testEvidence": {
    "realTtsEngineRequired": false,
    "networkRequired": false,
    "coversCommandSafety": true,
    "coversTimeoutKill": true,
    "coversCleanup": true,
    "coversWavValidation": true,
    "coversHttpContract": true,
    "coversStandaloneApiPath": true,
    "coversMp3Validation": true,
    "coversInProcessEdgeSynthesis": true,
    "coversAvaHttpContract": true,
    "coversAvaNativeG2p": true
  },
  "fallbackProvider": "edge-tts",
  "edgeAdapter": {
    "pythonPackage": "edge-tts",
    "voiceDefault": "fa-IR-FaridNeural",
    "textTransport": "in-process-python-module",
    "mediaFormat": "mp3",
    "localGpuRequired": false,
    "networkRequired": true,
    "shell": false,
    "temporaryFileRequired": false
  },
  "legacyFallbackProvider": "local-command",
  "avaAdapter": {
    "model": "xmanii/Ava-82M",
    "modelVersion": "0.2.0",
    "license": "Apache-2.0",
    "device": "cpu",
    "sampleRate": 24000,
    "workerPort": 9022,
    "python": ">=3.11,<3.14",
    "localGpuRequired": false,
    "networkRequiredAfterModelCache": false,
    "contextualPersianG2p": true,
    "pronunciationOverrides": true,
    "defaultDevelopmentRuntime": true
  }
}
