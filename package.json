{
  "name": "interview-platform",
  "version": "0.3.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=25.9.0 <26",
    "npm": ">=11.6.2 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "node scripts/check-workspaces.mjs",
    "workspace:check": "node scripts/check-workspaces.mjs",
    "install:clean": "node scripts/clean-npm-install.mjs",
    "dev": "turbo run dev --parallel",
    "dev:web": "npm run dev --workspace=@interview/web",
    "dev:api": "npm run dev --workspace=@interview/api",
    "dev:bootstrap": "node scripts/bootstrap-development.mjs",
    "media-worker:dev": "python services/media-worker/server.py",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:debug": "playwright test --debug",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:seed": "node scripts/bootstrap-development.mjs",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "npm run db:validate && npm run web:contracts && npm run lint && npm run typecheck && npm run test && npm run build",
    "workstation:check": "node scripts/check-workstation.mjs",
    "realtime:check": "node scripts/check-realtime-tools.mjs",
    "web:contracts": "node scripts/check-web-contract-usage.mjs",
    "db:validate": "node scripts/check-migrations.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:migrate": "npm run db:migrate --workspace=@interview/db",
    "db:performance": "npm run db:performance --workspace=@interview/db",
    "db:studio": "npm run db:studio --workspace=@interview/db",
    "load:test": "node scripts/load-test.mjs",
    "openapi:export": "npm run openapi:export --workspace=@interview/api",
    "api-client:generate": "npm run generate --workspace=@interview/api-client",
    "api:sync": "npm run openapi:export && npm run api-client:generate"
  },
  "scarfSettings": {
    "enabled": false
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
