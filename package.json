{
  "name": "interview-platform",
  "version": "0.2.0",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @interview/web dev",
    "dev:api": "pnpm --filter @interview/api dev",
    "dev:bootstrap": "node scripts/bootstrap-development.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "workstation:check": "node scripts/check-workstation.mjs",
    "registry:check": "node scripts/check-registry.mjs",
    "db:check": "node scripts/check-database.mjs",
    "db:migrate": "pnpm --filter @interview/db db:migrate",
    "db:studio": "pnpm --filter @interview/db db:studio",
    "openapi:export": "pnpm --filter @interview/api openapi:export",
    "api-client:generate": "pnpm --filter @interview/api-client generate",
    "api:sync": "pnpm openapi:export && pnpm api-client:generate"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0"
  }
}
