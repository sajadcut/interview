{
  "openapi": "3.0.0",
  "info": {
    "title": "Interview Platform API",
    "description": "Core API for the AI Recruiter platform",
    "version": "0.1.0"
  },
  "paths": {
    "/": {
      "get": {
        "operationId": "AppController_getBootstrapStatus",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["service", "status"],
                  "properties": {
                    "service": { "type": "string" },
                    "status": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_health",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status", "service", "timestamp"],
                  "properties": {
                    "status": { "type": "string", "enum": ["ok"] },
                    "service": { "type": "string" },
                    "timestamp": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": { "type": "http", "scheme": "bearer", "bearerFormat": "JWT" },
      "organization": { "type": "apiKey", "in": "header", "name": "x-organization-id" }
    },
    "schemas": {}
  }
}
