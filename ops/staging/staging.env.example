# TEMPLATE ONLY. Copy to a deployment secret store or .env.staging.local and replace every REPLACE_ME.
# Never commit the rendered staging environment.
NODE_ENV=production
SUPERVISED_PILOT_ENABLED=false
DATABASE_URL=postgresql://interview:REPLACE_ME@db.staging.internal:5432/interview
STAGING_API_BASE_URL=https://api.staging.example.com

MEDIA_REALTIME_ENABLED=true
MEDIA_TRANSPORT_PROVIDER=livekit
MEDIA_PROVIDER_TIMEOUT_MS=2500
LIVEKIT_URL=wss://rtc.staging.example.com
LIVEKIT_HEALTH_URL=https://rtc.staging.example.com
LIVEKIT_API_KEY=REPLACE_ME
LIVEKIT_API_SECRET=REPLACE_ME
LIVEKIT_TOKEN_TTL_SECONDS=300
TURN_URLS=turn:turn.staging.example.com:3478?transport=udp,turns:turn.staging.example.com:5349?transport=tcp

MEDIA_WORKER_SHARED_SECRET=REPLACE_ME
MEDIA_WORKER_BASE_URL=https://media.staging.example.com
FFMPEG_ENABLED=true
FFMPEG_CLI=ffmpeg
FFMPEG_TIMEOUT_SECONDS=120
WHISPER_CLI=whisper-cli
WHISPER_MODEL_PATH=/opt/interview/models/REPLACE_ME.bin
WHISPER_LANGUAGE=auto
STT_PROVIDER=whisper-http
STT_BASE_URL=https://media.staging.example.com/stt
STT_REQUEST_TIMEOUT_MS=130000

VAD_PROVIDER=silero-http
VAD_BASE_URL=https://vad.staging.example.com
TTS_PROVIDER=local-http
TTS_BASE_URL=https://tts.staging.example.com
TTS_COMMAND=REPLACE_ME

LLM_PROVIDER=openai-compatible
LLM_MODEL=REPLACE_ME
LLM_API_KEY=REPLACE_ME
LLM_BASE_URL=https://api.openai.com/v1
AI_WORKER_SHARED_SECRET=REPLACE_ME
AI_INTERVIEWER_BASE_URL=https://ai-interviewer.staging.example.com

# Optional synthetic phrase. Do not use candidate data or customer PII here.
STAGING_SMOKE_TEXT=این یک تست فنی Kubernetes و Redis برای مسیر صوتی مصاحبه است.
