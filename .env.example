# Shared monorepo environment
# Both API and Web load this root .env in local development.

# Web
NEXT_PUBLIC_APP_NAME=Interview Platform
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100
# Server-side target used by the Next.js same-origin API proxy.
API_INTERNAL_URL=http://127.0.0.1:4100
# Visual target defaults to English; switch to fa for RTL/Persian review.
NEXT_PUBLIC_DEFAULT_LOCALE=en

# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4100
# CORS source of truth. Use one origin, a comma-separated allowlist, or *.
# Examples:
# CORS_ORIGIN=http://localhost:3000
# CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000,https://app.example.com
# CORS_ORIGIN=*
CORS_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://interview:interview@localhost:5432/interview
LOCAL_STORAGE_ROOT=.local-data/storage

# Local development bootstrap
DEV_ORGANIZATION_NAME=Local Interview Organization
DEV_ORGANIZATION_SLUG=local-interview
DEV_USER_EMAIL=admin@local.interview
DEV_USER_DISPLAY_NAME=Local Admin

# LLM gateway (disabled until configured)
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1

# Realtime interview media. Disabled until every required provider is configured and healthy.
MEDIA_REALTIME_ENABLED=false
MEDIA_PROVIDER_TIMEOUT_MS=2500

# Transport: self-hosted LiveKit OSS. Do not commit real credentials.
MEDIA_TRANSPORT_PROVIDER=disabled
LIVEKIT_URL=
LIVEKIT_HEALTH_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=300
# Comma-separated coturn/STUN/TURN URLs for deployment/network validation.
TURN_URLS=

# Local media worker process.
MEDIA_WORKER_HOST=127.0.0.1
MEDIA_WORKER_PORT=9010
MEDIA_WORKER_BASE_URL=http://127.0.0.1:9010

# Voice activity detection. The bundled worker exposes /vad/health and /vad/analyze.
VAD_PROVIDER=disabled
VAD_BASE_URL=http://127.0.0.1:9010/vad

# Speech-to-text. The bundled worker exposes /stt/health and /stt/finalize.
STT_PROVIDER=disabled
STT_BASE_URL=http://127.0.0.1:9010/stt
WHISPER_CLI=whisper-cli
WHISPER_MODEL_PATH=
WHISPER_LANGUAGE=auto
WHISPER_TIMEOUT_SECONDS=120

# Text-to-speech. Stage 5 uses a local command template through /tts.
TTS_PROVIDER=disabled
TTS_BASE_URL=http://127.0.0.1:9010/tts
TTS_COMMAND=

# Digital human/avatar is optional for audio mode and required for avatar mode.
AVATAR_PROVIDER=disabled
AVATAR_BASE_URL=
