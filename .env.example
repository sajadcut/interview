# Shared monorepo environment
# Both API and Web load this root .env in local development.

# Web
NEXT_PUBLIC_APP_NAME=Interview Platform
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100
API_INTERNAL_URL=http://127.0.0.1:4100
NEXT_PUBLIC_DEFAULT_LOCALE=en

# API
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4100
CORS_ORIGIN=http://localhost:3000
# Fail closed: real SUPERVISED_PILOT admission is blocked unless this is explicitly true.
SUPERVISED_PILOT_ENABLED=false
DATABASE_URL=postgresql://interview:interview@localhost:5432/interview
LOCAL_STORAGE_ROOT=.local-data/storage

# Real outbound email. Keep disabled until exactly one provider is configured.
# EMAIL_PROVIDER=disabled | smtp | ses | sendgrid
EMAIL_PROVIDER=disabled
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=Interview Platform
EMAIL_REPLY_TO=
EMAIL_TIMEOUT_MS=10000
EMAIL_MAX_ATTEMPTS=3
EMAIL_RETRY_BASE_MS=250

# SMTP. Port 587 + STARTTLS is the default. Production refuses plaintext SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS_SERVERNAME=

# Amazon SES v2 HTTPS API. Static credentials are required by this local-native adapter.
# SES_ENDPOINT is optional and normally left empty so the regional AWS endpoint is used.
SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_SESSION_TOKEN=
SES_ENDPOINT=

# SendGrid v3 API. SENDGRID_BASE_URL is optional and normally left empty.
SENDGRID_API_KEY=
SENDGRID_BASE_URL=

# Real interview calendar delivery. Disabled keeps local scheduling without creating a remote event.
# CALENDAR_PROVIDER=disabled | google | microsoft
CALENDAR_PROVIDER=disabled
CALENDAR_TIMEOUT_MS=10000
CALENDAR_MAX_ATTEMPTS=3
CALENDAR_RETRY_BASE_MS=250

# Google Calendar: service-account JWT OAuth. Share the target calendar with the service account,
# or configure domain-wide delegation and GOOGLE_CALENDAR_DELEGATED_SUBJECT.
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_SERVICE_ACCOUNT_EMAIL=
# PEM may be stored with literal \n characters in environment systems.
GOOGLE_CALENDAR_PRIVATE_KEY=
GOOGLE_CALENDAR_DELEGATED_SUBJECT=
GOOGLE_CALENDAR_TOKEN_URL=
GOOGLE_CALENDAR_API_BASE_URL=
GOOGLE_CALENDAR_SEND_UPDATES=all
GOOGLE_CALENDAR_CREATE_MEET=false

# Microsoft 365 Calendar: Entra client-credentials OAuth with application Calendars.ReadWrite.
# MICROSOFT_CALENDAR_USER_ID is the mailbox UPN or user id used as the organizer.
MICROSOFT_CALENDAR_TENANT_ID=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_USER_ID=
MICROSOFT_CALENDAR_ID=
MICROSOFT_CALENDAR_TOKEN_URL=
MICROSOFT_CALENDAR_GRAPH_BASE_URL=
MICROSOFT_CALENDAR_CREATE_TEAMS_MEETING=false

# Local development bootstrap
DEV_ORGANIZATION_NAME=Local Interview Organization
DEV_ORGANIZATION_SLUG=local-interview
DEV_USER_EMAIL=admin@local.interview
DEV_USER_DISPLAY_NAME=Local Admin

# LLM gateway
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1

# AI background worker. Use the same non-empty local secret in API and worker processes.
# Never commit a real production value.
AI_WORKER_SHARED_SECRET=
AI_WORKER_API_URL=http://127.0.0.1:4100
AI_WORKER_CONCURRENCY=2
AI_WORKER_POLL_INTERVAL_MS=1000
AI_WORKER_LEASE_MS=120000
AI_WORKER_HEARTBEAT_MS=15000
AI_WORKER_REQUEST_TIMEOUT_MS=10000

# Coding assessment sandbox worker. This service is independent from AI/media/realtime workers.
# Candidate source is never executed by the core API. Pre-pull and pin production images before enabling.
ASSESSMENT_WORKER_SHARED_SECRET=
ASSESSMENT_WORKER_API_URL=http://127.0.0.1:4100
ASSESSMENT_WORKER_POLL_INTERVAL_MS=1000
ASSESSMENT_WORKER_LEASE_MS=120000
ASSESSMENT_WORKER_HEARTBEAT_MS=15000
ASSESSMENT_WORKER_REQUEST_TIMEOUT_MS=10000
ASSESSMENT_CONTAINER_RUNTIME=docker
ASSESSMENT_NODE_IMAGE=node:24-alpine
ASSESSMENT_PYTHON_IMAGE=python:3.13-alpine

# Privacy deletion worker. API owns DB/storage credentials; the worker only leases approved jobs.
# Use an independent production secret and keep deletion execution fail-closed when it is absent.
PRIVACY_WORKER_SHARED_SECRET=
PRIVACY_WORKER_API_URL=http://127.0.0.1:4100
PRIVACY_WORKER_POLL_INTERVAL_MS=1000
PRIVACY_WORKER_LEASE_MS=120000
PRIVACY_WORKER_HEARTBEAT_MS=15000
PRIVACY_WORKER_REQUEST_TIMEOUT_MS=10000
PRIVACY_WORKER_EXECUTION_TIMEOUT_MS=600000

# Automatic retention worker. Keep dry-run enabled until policy previews are reviewed.
# Candidate retention delegates verified erasure to the privacy worker above.
RETENTION_WORKER_SHARED_SECRET=
RETENTION_WORKER_API_URL=http://127.0.0.1:4100
RETENTION_WORKER_DRY_RUN=true
RETENTION_WORKER_POLL_INTERVAL_MS=5000
RETENTION_WORKER_SCHEDULE_INTERVAL_MS=3600000
RETENTION_WORKER_LEASE_MS=120000
RETENTION_WORKER_HEARTBEAT_MS=15000
RETENTION_WORKER_REQUEST_TIMEOUT_MS=10000
RETENTION_WORKER_EXECUTION_TIMEOUT_MS=600000

# Realtime interview media
MEDIA_REALTIME_ENABLED=false
MEDIA_PROVIDER_TIMEOUT_MS=2500
# Local-only secret shared by API and media-worker POST endpoints. Never commit the real value.
MEDIA_WORKER_SHARED_SECRET=

# Transport: self-hosted LiveKit OSS. Never commit real credentials.
MEDIA_TRANSPORT_PROVIDER=disabled
LIVEKIT_URL=
LIVEKIT_HEALTH_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_TOKEN_TTL_SECONDS=300
TURN_URLS=

# Local media worker
MEDIA_WORKER_HOST=127.0.0.1
MEDIA_WORKER_PORT=9010
MEDIA_WORKER_BASE_URL=http://127.0.0.1:9010

# FFmpeg process layer. Keep disabled on machines that do not have FFmpeg installed.
FFMPEG_ENABLED=false
FFMPEG_CLI=ffmpeg
FFMPEG_TIMEOUT_SECONDS=120
FFMPEG_TERMINATION_GRACE_SECONDS=2
# Optional parent directory for owned temporary FFmpeg workspaces.
FFMPEG_WORK_ROOT=

# VAD
VAD_PROVIDER=disabled
VAD_BASE_URL=http://127.0.0.1:9010/vad

# STT: API -> media-worker Whisper contract v1. Client timeout should exceed WHISPER_TIMEOUT_SECONDS.
STT_PROVIDER=disabled
STT_BASE_URL=http://127.0.0.1:9010/stt
STT_REQUEST_TIMEOUT_MS=130000
STT_MAX_ATTEMPTS=3
STT_RETRY_BASE_MS=250
WHISPER_CLI=whisper-cli
WHISPER_MODEL_PATH=
WHISPER_LANGUAGE=auto
WHISPER_TIMEOUT_SECONDS=120

# TTS command template must consume UTF-8 text_file and produce output_wav.
TTS_PROVIDER=disabled
TTS_BASE_URL=http://127.0.0.1:9010/tts
TTS_COMMAND=
TTS_TIMEOUT_SECONDS=60

# Avatar
AVATAR_PROVIDER=disabled
AVATAR_BASE_URL=
